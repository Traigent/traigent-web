{
  "name": "traigent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "http//www.traigent.ai",
  "scripts": {
    "version": "./scripts/update-version.sh",
    "dev": "vite",
    "start": "vite",
    "test:csp": "node --test scripts/check_csp_connect_src.test.mjs",
    "test:funnel": "node --test scripts/funnel_ux_contract.test.mjs scripts/funnel_component.test.mjs",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "format:csp:check": "prettier --check \"scripts/check_csp_connect_src*.mjs\" \"scripts/funnel_*.test.mjs\"",
    "prebuild": "npm run gate:accepted-risk && ./scripts/update-version.sh && npm run test:csp && npm run test:funnel && node scripts/check_csp_connect_src.mjs",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "gate:accepted-risk": "node scripts/check_accepted_risk.mjs",
    "test": "node --test scripts/tests/",
    "validate:replay": "node scripts/validate_replay.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.284.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "gh-pages": "^6.0.0",
    "jsdom": "^26.1.0",
    "parse5": "8.0.1",
    "postcss": "^8.4.31",
    "prettier": "3.9.6",
    "tailwindcss": "^3.3.3",
    "vite": "^7.3.5"
  },
  "overrides": {
    "@ungap/structured-clone": "^1.3.1"
  }
}
